# Lightweight aigw image built on the deployment host from a
# cross-compiled linux/amd64 binary. Inherits the Envoy cache from an
# existing aigw-custom image to skip the Envoy download.
# The base image mirrors the upstream aigw runtime so Envoy downloads and execs
# cleanly (distroless base-nossl + glibc). We inherit the existing aigw-custom
# image's Envoy cache instead of re-downloading so we don't need outbound
# internet at build time.
FROM aigw-custom:latest AS envoy-cache

FROM gcr.io/distroless/base-nossl-debian12:nonroot
ARG AIGW_VERSION=mcp-content-filter
COPY --from=envoy-cache /home/nonroot /home/nonroot
COPY --chown=65532:65532 --chmod=0755 aigw /app
USER nonroot:nonroot
ENV AIGW_RUN_ID=0
ENTRYPOINT ["/app"]
CMD ["run"]
